{
  "name": "@compallm/storybook",
  "version": "0.1.0",
  "type": "module",
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "storybook dev --port 6006 --host 127.0.0.1 --exact-port --no-open --disable-telemetry",
    "start": "storybook dev --port 6006 --host 127.0.0.1 --exact-port --no-open --disable-telemetry",
    "build": "vite build --config vite.library.config.ts && tsc -p tsconfig.build.json && node scripts/finish-build.mjs",
    "build:storybook": "storybook build --disable-telemetry && vite build --config vite.pages.config.ts && node scripts/finish-pages.mjs",
    "check": "tsc --noEmit",
    "lint": "prettier . --write && eslint . --fix",
    "lint:check": "eslint . && prettier . --check",
    "test": "playwright test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/addon-mcp": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "prettier": "^3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.4",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8",
    "vite": "8.3.4"
  },
  "description": "Compallm React components and pages, designed and previewed in Storybook",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json",
    "./pages/signup": {
      "types": "./dist/pages/signup/index.d.ts",
      "import": "./dist/pages/signup.js"
    },
    "./pages/signin": {
      "types": "./dist/pages/signin/index.d.ts",
      "import": "./dist/pages/signin.js"
    }
  }
}
