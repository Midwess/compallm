{
  "openapi": "3.1.0",
  "info": {
    "title": "compallm-server",
    "description": "Loco and Axum API with a Vite frontend and an Orval-generated client",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/greeting": {
      "get": {
        "operationId": "getGreeting",
        "responses": {
          "200": {
            "description": "Return the default greeting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Greeting"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createGreeting",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGreeting"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Create a personalized greeting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Greeting"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateGreeting": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "Greeting": {
        "type": "object",
        "required": [
          "message",
          "servedBy",
          "requestCount"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "requestCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "servedBy": {
            "type": "string"
          }
        }
      }
    }
  }
}