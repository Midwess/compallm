{
  "name": "@compallm/storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6007 --host 127.0.0.1 --exact-port --no-open --disable-telemetry",
    "start": "npm run dev",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:check": "npm run lint && npm run format:check",
    "build": "svelte-package -i src && vite build",
    "build:storybook": "storybook build --disable-telemetry",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0 && npm run format",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/styles/theme.css",
    "./foundations.css": "./src/styles/foundations.css",
    "./context": {
      "types": "./dist/context.d.ts",
      "svelte": "./src/context.ts",
      "default": "./dist/context.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "svelte": "./src/components/*.ts",
      "default": "./dist/components/*.js"
    },
    "./pages/*": {
      "types": "./dist/pages/*/index.d.ts",
      "svelte": "./src/pages/*/index.ts",
      "default": "./dist/pages/*/index.js"
    },
    "./pages/auth/model": {
      "types": "./dist/pages/auth/store.d.ts",
      "svelte": "./src/pages/auth/store.ts",
      "default": "./dist/pages/auth/store.js"
    },
    "./state": {
      "types": "./dist/state.svelte.d.ts",
      "svelte": "./src/state.svelte.ts",
      "default": "./dist/state.svelte.js"
    },
    "./pages/invitation": {
      "types": "./dist/pages/invitation.d.ts",
      "svelte": "./src/pages/invitation.ts",
      "default": "./dist/pages/invitation.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "LICENSE-spinkit"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@compallm/contract": "file:../contract",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@paper-design/shaders": "0.0.82",
    "@tsparticles/confetti": "3.9.1",
    "bits-ui": "2.22.0",
    "bowser": "2.13.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "lodash-es": "4.18.1",
    "motion": "14.12.0",
    "ogl": "1.0.11",
    "phosphor-svelte": "3.1.1",
    "scheduler-polyfill": "1.3.0",
    "shiki": "4.6.0",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "svelte": "^5.59.1"
  },
  "devDependencies": {
    "@cedar-policy/cedar-wasm": "4.14.0",
    "@eslint/js": "9.39.2",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/svelte-vite": "10.6.8",
    "@sveltejs/package": "3.0.3",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/lodash-es": "4.17.12",
    "eslint": "9.39.2",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.9.0",
    "prettier-plugin-svelte": "4.2.0",
    "storybook": "10.6.8",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.13"
  },
  "license": "Elastic-2.0",
  "description": "Compallm Svelte components and pages, designed and previewed in Storybook"
}
