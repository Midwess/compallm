{
  "name": "compallm",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cargo run -p compallm-server --features frontend-dev -- start",
    "dev:vite": "cargo run --quiet -p compallm-server -- generate && vite",
    "generate": "cargo run --quiet -p compallm-server -- generate",
    "build": "cargo run --quiet -p compallm-server -- generate && tsc -b && vite build && cargo build --release -p compallm-server",
    "start": "cargo run --release -p compallm-server -- --environment production start",
    "server:routes": "cargo loco routes",
    "server:doctor": "cargo loco --environment production doctor",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "orval": "^8.43.0",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
