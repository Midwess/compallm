{
  "name": "cosin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cargo run -p cosin-server --features frontend-dev -- start",
    "dev:vite": "cargo run --quiet -p cosin-server -- generate && vite",
    "generate": "cargo run --quiet -p cosin-server -- generate",
    "build": "cargo run --quiet -p cosin-server -- generate && tsc -b && vite build && cargo build --release -p cosin-server",
    "start": "cargo run --release -p cosin-server -- --environment production start",
    "server:routes": "cargo loco routes",
    "server:doctor": "cargo loco --environment production doctor",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "orval": "^8.43.0",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
