{
  "name": "@compallm/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Elastic-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:graphql": "genql --schema schema.graphql --output graphql --sort"
  },
  "exports": {
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./graphql": {
      "types": "./dist/graphql.d.ts",
      "import": "./dist/graphql.js"
    }
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@genql/cli": "^6.3.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
