{
  "name": "@compallm/storybook",
  "version": "0.1.0",
  "type": "module",
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "storybook dev --port 6006 --host 127.0.0.1 --exact-port --no-open --disable-telemetry",
    "start": "storybook dev --port 6006 --host 127.0.0.1 --exact-port --no-open --disable-telemetry",
    "build": "vite build --config vite.library.config.ts && tsc -p tsconfig.build.json && node scripts/finish-build.mjs",
    "build:storybook": "storybook build --disable-telemetry && vite build --config vite.pages.config.ts && node scripts/finish-pages.mjs",
    "check": "tsc --noEmit",
    "lint": "prettier . --write && eslint . --fix",
    "lint:check": "eslint . && prettier . --check",
    "prepack": "npm run build",
    "postinstall": "npm --prefix ../contract ci --ignore-scripts && npm --prefix ../contract run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "dompurify": "^3.4.17",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16",
    "@compallm/contract": "file:../contract"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/addon-mcp": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "prettier": "^3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.4",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8",
    "vite": "8.3.4"
  },
  "description": "Compallm React components and pages, designed and previewed in Storybook",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": {
      "compallm-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "compallm-source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": {
      "compallm-source": "./src/styles/tailwind.css",
      "default": "./dist/styles.css"
    },
    "./theme.css": {
      "compallm-source": "./src/styles/theme.css",
      "default": "./dist/theme.css"
    },
    "./package.json": "./package.json",
    "./pages/signup": {
      "compallm-source": "./src/pages/signup/index.tsx",
      "types": "./dist/pages/signup/index.d.ts",
      "import": "./dist/pages/signup.js"
    },
    "./pages/signin": {
      "compallm-source": "./src/pages/signin/index.tsx",
      "types": "./dist/pages/signin/index.d.ts",
      "import": "./dist/pages/signin.js"
    },
    "./context": {
      "compallm-source": "./src/context.ts",
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./pages/main": {
      "compallm-source": "./src/pages/main/index.tsx",
      "types": "./dist/pages/main/index.d.ts",
      "import": "./dist/pages/main.js"
    },
    "./pages/organization": {
      "compallm-source": "./src/pages/organization/index.tsx",
      "types": "./dist/pages/organization/index.d.ts",
      "import": "./dist/pages/organization.js"
    },
    "./pages/organization/chat": {
      "compallm-source": "./src/pages/organization/chat/index.tsx",
      "types": "./dist/pages/organization/chat/index.d.ts",
      "import": "./dist/pages/organization/chat.js"
    },
    "./pages/organization/create-provider": {
      "compallm-source": "./src/pages/organization/create-provider/index.tsx",
      "types": "./dist/pages/organization/create-provider/index.d.ts",
      "import": "./dist/pages/organization/create-provider.js"
    }
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
