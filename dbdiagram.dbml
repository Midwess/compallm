Project compallm {
  database_type: 'PostgreSQL'
  Note: 'Compallm application schema (PostgreSQL 18). Primary keys are application-generated Hero snowflake IDs (bigint); the database defines no sequences, views, or triggers.'
}

Enum user_status {
  active
  disabled
}

Enum organization_status {
  active
  disabled
}

Enum organization_role {
  owner
  admin
  member
}

Enum api_protocol {
  anthropic
  openai
  openai_compatible
}

Enum provider_usage_status {
  in_progress
  succeeded
  failed
  cancelled
  incomplete
}

Table users {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  email text [not null, note: 'CHECK (email <> \'\')']
  display_name text [not null]
  status user_status [not null, default: 'active']
  email_verified_at timestamptz [not null]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

}

Table organizations {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  name text [not null, note: 'CHECK (length(btrim(name)) > 0)']

  status organization_status [not null, default: 'active']
  created_by bigint [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table organization_members {
  organization_id bigint [not null]
  user_id bigint [not null]
  role organization_role [not null]
  status user_status [not null, default: 'active']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (organization_id, user_id) [pk, name: 'organization_members_pkey']
    user_id [name: 'organization_members_user_id_idx']
  }
}

Table api_keys [note: 'An organization member can own multiple API keys. Only the SHA-256 digest is stored; the plaintext key is returned once when created.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0); application-generated Hero snowflake ID']
  organization_id bigint [not null]
  user_id bigint [not null]
  value bytea [not null, unique, note: 'SHA-256 digest used for key lookup and constant-time authentication; never store the plaintext key']
  name text [not null, note: 'CHECK (length(btrim(name)) > 0); member-defined label']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  expires_at timestamptz [note: 'CHECK (expires_at IS NULL OR expires_at > created_at)']
  revoked_at timestamptz [note: 'CHECK (revoked_at IS NULL OR revoked_at >= created_at)']
  last_used_at timestamptz

  indexes {
    value [unique, name: 'api_keys_value_unique']
    (id, organization_id) [unique, name: 'api_keys_id_organization_unique']
    (id, organization_id, user_id) [unique, name: 'api_keys_id_organization_user_unique']
    (organization_id, user_id, created_at) [name: 'api_keys_member_created_at_idx']
  }
}

Table user_sessions {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  user_id bigint [not null]
  organization_id bigint [not null]
  refresh_token_id varchar(43) [not null, note: 'CHECK (refresh_token_id ~ \'^[A-Za-z0-9_-]{43}$\')']
  created_at timestamptz [not null]
  revoked_at timestamptz [note: 'CHECK (revoked_at IS NULL OR revoked_at >= created_at)']
}

Table providers {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  organization_id bigint [not null]
  name text [not null, note: 'CHECK (length(btrim(name)) > 0)']
  url text [not null, note: 'CHECK (length(btrim(url)) > 0)']
  api_key text [not null, note: 'CHECK (length(api_key) > 0); write-only secret']
  api_protocol api_protocol [not null]
  enabled boolean [not null, default: true]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (id, organization_id) [unique, name: 'providers_id_organization_unique']
  }
}

Table models {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  organization_id bigint [not null]
  name text [not null, note: 'CHECK (length(btrim(name)) > 0)']
  input_price_per_million_tokens numeric(20,8) [not null, note: 'CHECK (input_price_per_million_tokens >= 0)']
  output_price_per_million_tokens numeric(20,8) [not null, note: 'CHECK (output_price_per_million_tokens >= 0)']
  cached_price_per_million_tokens numeric(20,8) [not null, note: 'CHECK (cached_price_per_million_tokens >= 0)']
  enabled boolean [not null, default: true]
  hidden boolean [not null, default: false]
  settings jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (id, organization_id) [unique, name: 'models_id_organization_unique']
  }
}

Table model_providers [note: 'Model-provider route. Composite foreign keys on (model_id, organization_id) and (provider_id, organization_id) keep the route inside one organization.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  organization_id bigint [not null]
  model_id bigint [not null]
  provider_id bigint [not null]
  upstream_model_name text [not null, note: 'CHECK (length(btrim(upstream_model_name)) > 0)']
  priority integer [not null, note: 'CHECK (priority > 0)']
  enabled boolean [not null, default: true]
  input_price_per_million_tokens numeric(20,8) [not null, note: 'CHECK (input_price_per_million_tokens >= 0)']
  output_price_per_million_tokens numeric(20,8) [not null, note: 'CHECK (output_price_per_million_tokens >= 0)']
  cached_price_per_million_tokens numeric(20,8) [not null, note: 'CHECK (cached_price_per_million_tokens >= 0)']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (id, organization_id) [unique, name: 'model_providers_id_organization_unique']
    (id, provider_id, organization_id) [unique, name: 'model_providers_id_provider_organization_unique']
  }
}

Table usage [note: 'Authoritative logical-model token usage. Deleting a row also deletes its linked organization-member amount entry.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0); application-generated Hero snowflake ID']
  request_id bigint [not null, note: 'Client-facing request identifier. Becomes a foreign key when the request table is added']

  organization_id bigint [not null]
  user_id bigint
  api_key_id bigint
  model_id bigint

  input_token bigint [not null, default: 0, note: 'CHECK (input_token >= 0)']
  cached_token bigint [not null, default: 0, note: 'Cached input subset; CHECK (cached_token >= 0 AND cached_token <= input_token)']
  output_token bigint [not null, default: 0, note: 'CHECK (output_token >= 0)']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    request_id [unique, name: 'usage_request_unique']
    (id, organization_id, user_id) [unique, name: 'usage_id_organization_user_unique']
    (organization_id, created_at) [name: 'usage_organization_created_at_idx']
    (api_key_id, created_at) [name: 'usage_api_key_created_at_idx']
    (user_id, created_at) [name: 'usage_user_created_at_idx']
    (model_id, created_at) [name: 'usage_model_created_at_idx']
  }
}

Table organization_member_amounts [note: 'Signed amount ledger for an organization member. Positive rows add funds and usage-linked negative rows subtract funds. Current member amount is SUM(amount); no separate mutable balance is stored.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0); application-generated Hero snowflake ID']
  organization_id bigint [not null]
  user_id bigint [not null]
  usage_id bigint [unique, note: 'NULL for added funds; set for a logical-model usage debit']
  amount numeric(24,12) [not null, note: 'Positive adds member amount; negative subtracts member amount; CHECK (amount <> 0)']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    usage_id [unique, name: 'organization_member_amounts_usage_unique']
    (organization_id, user_id, created_at) [name: 'organization_member_amounts_member_created_at_idx']
  }
}

Table provider_usage [note: 'One row per upstream provider attempt. Authoritative for provider token consumption, retries, fallback, and result status; it does not determine the organization-member amount.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0); application-generated Hero snowflake ID']
  request_id bigint [not null, note: 'Client-facing request identifier; becomes a foreign key when the request table is added']

  organization_id bigint [not null]
  model_provider_id bigint [not null]
  provider_id bigint [not null]
  provider_request_id text [note: 'Provider-issued request identifier when available; must not contain credentials']

  status provider_usage_status [not null, default: 'in_progress']
  input_tokens bigint [note: 'Total input tokens including cached input; NULL means unknown; CHECK (input_tokens >= 0)']
  cached_input_tokens bigint [note: 'Subset of input_tokens; NULL means unknown; CHECK (cached_input_tokens >= 0 AND cached_input_tokens <= input_tokens)']
  output_tokens bigint [note: 'NULL means unknown; CHECK (output_tokens >= 0)']

  indexes {
    request_id [name: 'provider_usage_request_idx']
    organization_id [name: 'provider_usage_organization_idx']
    provider_id [name: 'provider_usage_provider_idx']
    model_provider_id [name: 'provider_usage_route_idx']
    provider_request_id [name: 'provider_usage_provider_request_id_idx']
  }
}

// --- Relationships ---

Ref organizations_created_by_fkey: organizations.created_by > users.id [delete: restrict, update: no action]

Ref organization_members_organization_id_fkey: organization_members.organization_id > organizations.id [delete: cascade, update: no action]
Ref organization_members_user_id_fkey: organization_members.user_id > users.id [delete: cascade, update: no action]
Ref api_keys_membership_fkey: api_keys.(organization_id, user_id) > organization_members.(organization_id, user_id) [delete: cascade, update: no action]

Ref user_sessions_organization_fk: user_sessions.organization_id > organizations.id [delete: cascade, update: no action]
Ref user_sessions_user_fk: user_sessions.user_id > users.id [delete: cascade, update: no action]

Ref providers_organization_id_fkey: providers.organization_id > organizations.id [delete: cascade, update: no action]

Ref models_organization_id_fkey: models.organization_id > organizations.id [delete: cascade, update: no action]

// Composite scope foreign keys keep a route inside a single organization.
Ref model_providers_provider_scope_fkey: model_providers.(provider_id, organization_id) > providers.(id, organization_id) [delete: cascade, update: no action]
Ref model_providers_model_scope_fkey: model_providers.(model_id, organization_id) > models.(id, organization_id) [delete: cascade, update: no action]

Ref usage_organization_fkey: usage.organization_id > organizations.id [delete: restrict, update: no action]
Ref usage_membership_fkey: usage.(organization_id, user_id) > organization_members.(organization_id, user_id) [delete: restrict, update: no action]
Ref usage_api_key_scope_fkey: usage.(api_key_id, organization_id) > api_keys.(id, organization_id) [delete: restrict, update: no action]
Ref usage_api_key_owner_fkey: usage.(api_key_id, organization_id, user_id) > api_keys.(id, organization_id, user_id) [delete: restrict, update: no action]
Ref usage_model_scope_fkey: usage.(model_id, organization_id) > models.(id, organization_id) [delete: restrict, update: no action]

Ref organization_member_amounts_membership_fkey: organization_member_amounts.(organization_id, user_id) > organization_members.(organization_id, user_id) [delete: restrict, update: no action]
Ref organization_member_amounts_usage_fkey: organization_member_amounts.(usage_id, organization_id, user_id) > usage.(id, organization_id, user_id) [delete: cascade, update: no action]

Ref provider_usage_organization_fkey: provider_usage.organization_id > organizations.id [delete: restrict, update: no action]
Ref provider_usage_route_provider_scope_fkey: provider_usage.(model_provider_id, provider_id, organization_id) > model_providers.(id, provider_id, organization_id) [delete: restrict, update: no action]
Ref provider_usage_provider_scope_fkey: provider_usage.(provider_id, organization_id) > providers.(id, organization_id) [delete: restrict, update: no action]
