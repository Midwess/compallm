{
  "name": "compallm-portal",
  "private": true,
  "version": "0.0.0",
  "license": "Elastic-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cargo run -p compallm-api --features frontend-dev -- start",
    "dev:vite": "cargo run --quiet -p compallm-api -- generate && vite",
    "generate": "cargo run --quiet -p compallm-api -- generate",
    "build": "cargo run --quiet -p compallm-api -- generate && tsc -b && vite build && cargo build --release -p compallm-api",
    "start": "cargo run --release -p compallm-api -- --environment production start",
    "api:routes": "cargo loco routes",
    "api:doctor": "cargo loco --environment production doctor",
    "lint": "prettier . --write && eslint . --fix",
    "preview": "vite preview",
    "lint:check": "eslint . && prettier . --check",
    "check": "tsc -b",
    "test": "playwright test",
    "postinstall": "npm --prefix ../libs/contract ci --ignore-scripts && npm --prefix ../libs/contract run build"
  },
  "dependencies": {
    "@compallm/storybook": "file:../libs/storybook",
    "lodash-es": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "zustand": "^5.0.16",
    "@compallm/contract": "file:../libs/contract"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "orval": "^8.43.0",
    "prettier": "^3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
