{
  "name": "compallm-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
    "lint:check": "npm run lint && npm run format:check",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0 && npm run format",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test tests/*.mjs",
    "dev:api": "cargo run -p compallm-api -- start",
    "dev:vite": "vite --host 127.0.0.1",
    "start": "cargo run --release -p compallm-api -- --environment production start",
    "serve": "HOST=127.0.0.1 PORT=4868 HOST_HEADER=x-forwarded-host PROTOCOL_HEADER=x-forwarded-proto node build/index.js"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.14.0",
    "@compallm/contract": "file:../libs/contract",
    "@compallm/storybook": "file:../libs/storybook",
    "lodash-es": "4.18.1",
    "set-cookie-parser": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@opentelemetry/api": "1.9.0",
    "@sveltejs/adapter-node": "6.0.5",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/lodash-es": "4.17.12",
    "@types/set-cookie-parser": "2.4.10",
    "eslint": "9.39.2",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.9.0",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.13"
  },
  "license": "Elastic-2.0",
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
