{
  "name": "@compallm/storybook-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6007 --host 127.0.0.1 --exact-port --no-open --disable-telemetry",
    "start": "npm run dev",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:check": "eslint . && prettier . --check",
    "build": "svelte-package -i src && vite build",
    "build:storybook": "storybook build --disable-telemetry"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/styles/theme.css",
    "./foundations.css": "./src/styles/foundations.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@compallm/graphql-svelte": "file:../graphql-svelte",
    "@compallm/contract": "file:../contract"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "svelte": "5.57.1",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "svelte-check": "4.7.8",
    "prettier": "3.9.0",
    "prettier-plugin-svelte": "4.2.0",
    "tailwindcss": "4.3.4",
    "@tailwindcss/vite": "4.3.4",
    "@sveltejs/package": "2.5.8",
    "@storybook/svelte-vite": "10.6.8",
    "storybook": "10.6.8",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "eslint": "9.39.2",
    "@eslint/js": "9.39.2",
    "typescript-eslint": "8.73.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0"
  },
  "engines": {
    "node": ">=24.13"
  },
  "license": "Elastic-2.0"
}
