{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2023", "DOM"],
    "paths": {
      "$houdini": ["../graphql-svelte/.houdini/index.ts"],
      "$houdini/*": ["../graphql-svelte/.houdini/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "stories/**/*.ts", ".storybook/**/*.ts"]
}
