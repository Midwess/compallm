Project compallm {
  database_type: 'PostgreSQL'
  Note: 'Compallm schema (PostgreSQL 18). Models, providers, and provider_models show the proposed design in suggest-schema.md. Usage has five request/usage tables: model_usage plus independent token, image, audio, and video provider usage; model_usage_limit is separate. No shared provider_usage parent exists. Proposed persistence contracts are in docs/content/usage-administration/accounting.md. Primary keys and attempt IDs are application-generated Hero snowflake IDs (bigint); the database defines no sequences, views, or triggers.'
}

Enum user_status {
  active
  disabled
}

Enum organization_status {
  active
  disabled
}

Enum organization_role {
  owner
  admin
  member
}

Enum provider_usage_status {
  in_progress
  succeeded
  failed
  cancelled
  incomplete
}

Enum usage_direction {
  input
  output
}

Table users {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  email text [not null, note: 'CHECK (email <> \'\')']
  display_name text [not null]
  status user_status [not null, default: 'active']
  email_verified_at timestamptz [not null]
  last_login_at timestamptz
}

Table organizations {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  name text [not null, note: 'CHECK (length(btrim(name)) > 0)']

  status organization_status [not null, default: 'active']
}

Table organization_members {
  organization_id bigint [not null]
  user_id bigint [not null]
  role organization_role [not null]
  status user_status [not null, default: 'active']
  indexes {
    (organization_id, user_id) [pk, name: 'organization_members_pkey']
    user_id [name: 'organization_members_user_id_idx']
  }
}

Table api_keys [note: 'An organization member can own multiple API keys. Only the SHA-256 digest is stored; the plaintext key is returned once when created.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0); application-generated Hero snowflake ID']
  organization_id bigint [not null]
  user_id bigint [not null]
  value bytea [not null, note: 'SHA-256 digest used for key lookup and constant-time authentication; never store the plaintext key']
  name text [not null, note: 'CHECK (length(btrim(name)) > 0); member-defined label']
  expires_at timestamptz
  revoked_at timestamptz
  last_used_at timestamptz

  indexes {
    value [unique, name: 'api_keys_value_unique']
    (organization_id, id) [unique, name: 'api_keys_organization_id_id_unique']
    (organization_id, user_id, id) [unique, name: 'api_keys_organization_user_id_unique']
  }
}

Table user_sessions {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  user_id bigint [not null]
  organization_id bigint [not null]
  revoked_at timestamptz
}

Table providers [note: 'Proposed API-key connection shared by provider models. Owns one protected API key, shared connection settings, and headers. Service kind and protocol belong to each provider model.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  organization_id bigint [not null]
  name text [not null, note: 'Nonblank connection name, normalized by trimming; unique within the organization']
  connection jsonb [not null, note: 'JSON object: baseUrl, timeoutMs, query, authentication. Bounded positive timeout; non-secret query parameters; authentication declares exactly one apiKeyHeader {name, prefix} or apiKeyQuery placement, never the key value']
  headers jsonb [not null, default: '{}', note: 'JSON object of non-secret custom headers; case-insensitive header names; cannot replace authentication or transport-managed headers']
  credentials text [not null, note: 'Private hashed credential for provider. Contains the API key and secret custom headers; excluded from ordinary reads and logs']

  indexes {
    (organization_id, id) [unique, name: 'providers_organization_id_id_unique']
    (organization_id, name) [unique, name: 'providers_organization_id_name_unique']
  }
}

Table models [note: 'Proposed organization-facing model sharing service_kind, enabled, capabilities, limits, thinking, and pricing shapes with provider_models. No provider_id, protocol, connection, or headers; model_router selects upstream transport. Values are independently configured, not inherited or merged. Typed fields replace generic settings and scalar prices. Disabled models cannot serve any route. Service/capability/limit compatibility and media member-charging rules remain unresolved.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  organization_id bigint [not null]
  name text [not null, note: 'CHECK (length(btrim(name)) > 0)']
  service_kind text [not null, note: 'ServiceKind: llm, image, video, embedding, tts, stt. Caller-facing operation, independent of upstream protocol']
  enabled boolean [not null, default: true, note: 'Model-level availability; enabling does not override a disabled provider model or router binding']
  capabilities jsonb [not null, default: '[]', note: 'JSON array of distinct Capability flags: text, vision, pdf, audio, video, image_generation, audio_generation, search, reasoning, tool_call, forced_tool_choice, structured_output. Only declared capabilities are available; forced_tool_choice requires tool_call. Caller-facing contract, not an automatic copy of upstream flags']
  limits jsonb [not null, default: '{}', note: 'JSON object: optional positive contextTokens, maxOutputTokens, maxImagesPerRequest, maxDurationMs, maxAudioBytes. Caller-facing limits; route matching remains to be defined']
  thinking jsonb [note: 'NULL means no configured controls. Same Thinking shape as provider_models: optional effort array and budget object, at least one non-null; both present means both supported. Effort is nonempty and distinct; budget has positive minTokens/maxTokens and optional defaultTokens within bounds. Non-null thinking requires reasoning capability']
  pricing jsonb [not null, note: 'Organization-facing prices, not upstream costs. Same Pricing shape as provider_models: exactly one token, audio, image, video, or request variant; exact nonnegative decimal-string USD rates within NUMERIC(20,8). Token requires inputUsdPerMillionTokens, outputUsdPerMillionTokens, cachedUsdPerMillionTokens. Sharing the shape does not define member-charging policy for media']

  indexes {
    (organization_id, id) [unique, name: 'models_organization_id_id_unique']
    (organization_id, name) [unique, name: 'models_organization_id_name_unique']
  }
}

Table provider_models [note: 'Proposed upstream model configuration using one explicit service_kind/protocol pair to select a concrete adapter. Supported pairs: llm with openai, openai_responses, anthropic, or gemini; image with openai or gemini; embedding with openai; tts with openai, minimax, or openrouter; stt with openai; video with xai. Unsupported pairs fail before dispatch. Suboperations come from the request and adapter contract, not a stored endpoint mode. Capability flags do not enable another service route. Availability requires an enabled logical model, provider model, and router binding. Composite foreign keys preserve organization scope.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  organization_id bigint [not null]
  provider_id bigint [not null]
  name text [not null, note: 'CHECK (length(btrim(name)) > 0); name accepted by the upstream provider']
  service_kind text [not null, note: 'ServiceKind: llm, image, video, embedding, tts, stt. Requested operation; llm with vision supports image understanding without selecting image generation. Stored as TEXT, validated as a Rust enum and supported service/protocol pair']
  enabled boolean [not null, default: true]
  protocol text [not null, note: 'Protocol: openai, openai_responses, anthropic, gemini, minimax, openrouter, xai. API-format or implementation family interpreted within service_kind, not an operation on its own. llm/openai uses Chat Completions; tts/openai uses speech; stt/openai uses transcription; tts/openrouter uses Chat Completions and SSE audio extraction. Planned adapter contracts, not implemented support; shared labels do not promise compatibility with every vendor']
  connection jsonb [note: 'NULL inherits the complete provider connection. A JSON object fully replaces it, including baseUrl, timeoutMs, query, and authentication; no partial merge. Uses the owning provider API key']
  headers jsonb [not null, default: '{}', note: 'Non-secret JSON header object merged over provider headers by case-insensitive name; secret headers applied separately; authentication and transport headers cannot be overridden']
  capabilities jsonb [not null, default: '[]', note: 'JSON array of distinct Capability flags: text, vision, pdf, audio, video, image_generation, audio_generation, search, reasoning, tool_call, forced_tool_choice, structured_output. Only declared capabilities are available; empty array declares none. forced_tool_choice requires tool_call. Flags do not authorize arbitrary parameters or implement adapters; numeric limits and reasoning controls remain separate']
  limits jsonb [not null, default: '{}', note: 'JSON object: optional positive contextTokens, maxOutputTokens, maxImagesPerRequest, maxDurationMs, maxAudioBytes']
  thinking jsonb [note: 'NULL means no reasoning controls configured, not a classification of support. Strict JSON object with independent optional effort and budget fields; at least one must be non-null. Both present means both controls are supported, with no separate combined variant; adapters validate request-level combinations. Effort is a nonempty array of distinct supported EffortLevel values with no configured default; budget declares minTokens, maxTokens, optional defaultTokens']
  pricing jsonb [not null, note: 'JSON object with exactly one typed variant: token, audio, image, video, request. Decimal USD amounts are strings, nonnegative, within NUMERIC(20,8) range and scale. Token requires inputUsdPerMillionTokens, outputUsdPerMillionTokens, cachedUsdPerMillionTokens. Audio uses usdPerSecond or usdPerMillionCharacters; image/video use nonempty conditional rates; request uses usdPerRequest. Core validates service compatibility, adapter billing measurements, and rate conditions']

  indexes {
    (organization_id, id) [unique, name: 'provider_models_organization_id_id_unique']
    (organization_id, provider_id, id) [unique, name: 'provider_models_organization_provider_id_unique']
    (organization_id, provider_id, name, service_kind, protocol) [unique, name: 'provider_models_org_provider_name_service_protocol_unique']
  }
}

Table model_router [note: 'A route binding one system model to one provider model. Composite foreign keys keep the binding inside one organization.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0)']
  organization_id bigint [not null]
  model_id bigint [not null]
  provider_model_id bigint [not null]
  priority integer [not null, note: 'CHECK (priority > 0)']
  enabled boolean [not null, default: true]

  indexes {
    (organization_id, provider_model_id, id) [unique, name: 'model_router_organization_provider_model_id_unique']
    (model_id, provider_model_id) [unique, name: 'model_router_model_id_provider_model_id_unique']
    (model_id, priority) [unique, name: 'model_router_model_id_priority_unique']
    (provider_model_id, model_id) [name: 'model_router_provider_model_id_model_id_idx']
  }
}

Table model_usage [note: 'One client request and its logical-model attribution. Four independent provider usage tables reference this record directly and own attempt metadata, pricing snapshots, and measurements. Deleting this row cascades directly to their rows; there is no shared provider-attempt table.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0); application-generated Hero snowflake ID']

  organization_id bigint [not null]
  user_id bigint
  api_key_id bigint
  model_id bigint

  indexes {
    (organization_id, id) [unique, name: 'model_usage_organization_id_id_unique']
    (organization_id, user_id, id) [unique, name: 'model_usage_organization_user_id_unique']
    (organization_id, api_key_id) [name: 'model_usage_organization_api_key_idx']
    (organization_id, model_id) [name: 'model_usage_organization_model_idx']
  }
}

Table model_usage_limit [note: 'One mutable USD usage-limit record per organization member, separate from the five request/usage tables. Request attribution remains in model_usage and the four independent provider usage tables.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0); application-generated Hero snowflake ID']
  organization_id bigint [not null]
  user_id bigint [not null]
  limit_usd numeric(24,12) [not null, note: 'Configured USD usage limit; CHECK (limit_usd >= 0)']
  current_usage_usd numeric(24,12) [not null, note: 'Accumulated USD usage for the active accounting period; CHECK (current_usage_usd >= 0)']
  indexes {
    (organization_id, user_id) [unique, name: 'model_usage_limit_organization_user_unique']
  }
}

Table provider_token_usage [note: 'Proposed independent token usage: one row per upstream attempt, linked directly to model_usage. Also usable by multimodal endpoints reporting tokens. attempt_id correlates other typed rows without a parent table; attribution, status, request ID, and snapshot must be consistent across those rows. All-null quantities preserve attempts with unknown usage; zero is explicit. Cached input and reasoning output are subsets requiring known parent totals, never additional tokens.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0); application-generated Hero snowflake ID']
  organization_id bigint [not null]
  model_usage_id bigint [not null]
  attempt_id bigint [not null, note: 'CHECK (attempt_id > 0); application-generated upstream-call correlation ID, not a foreign key. Retries and fallback allocate fresh IDs']
  model_router_id bigint [not null]
  provider_model_id bigint [not null]
  provider_id bigint [not null]
  provider_request_id text [note: 'Provider-issued request identifier when available; must not contain credentials']
  status provider_usage_status [not null, default: 'in_progress']
  pricing_snapshot jsonb [not null, note: 'Immutable complete provider-model Pricing copied at attempt creation; exactly one typed variant with exact decimal-string rates and conditions. Identical across correlated rows. The pricing variant selects billable quantities; token measurements alone do not authorize token charges']
  input_tokens bigint [note: 'Total input including cached input; CHECK (input_tokens >= 0)']
  cached_input_tokens bigint [note: 'Subset of input_tokens; CHECK (cached_input_tokens >= 0 AND input_tokens IS NOT NULL AND cached_input_tokens <= input_tokens) when present']
  output_tokens bigint [note: 'Total output including reasoning output; CHECK (output_tokens >= 0)']
  reasoning_output_tokens bigint [note: 'Subset of output_tokens; CHECK (reasoning_output_tokens >= 0 AND output_tokens IS NOT NULL AND reasoning_output_tokens <= output_tokens) when present']

  indexes {
    (organization_id, attempt_id) [unique, name: 'provider_token_usage_attempt_unique']
    (organization_id, model_usage_id) [name: 'provider_token_usage_model_usage_idx']
    (organization_id, provider_model_id) [name: 'provider_token_usage_provider_model_idx']
    (organization_id, model_router_id) [name: 'provider_token_usage_route_idx']
    (organization_id, provider_id, provider_request_id) [name: 'provider_token_usage_request_idx']
  }
}

Table provider_image_usage [note: 'Proposed independent image usage linked directly to model_usage. Multiple non-overlapping billing groups per attempt; group_index is stable for idempotent updates, not an asset ID. attempt_id correlates other typed records without a shared parent; repeated attribution, status, request ID, and snapshot must agree. NULL quantity preserves unknown or failed usage. No image content or URLs. Domain validation rejects overlapping groups and ambiguous rates.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0); application-generated Hero snowflake ID']
  organization_id bigint [not null]
  model_usage_id bigint [not null]
  attempt_id bigint [not null, note: 'CHECK (attempt_id > 0); upstream-call correlation ID, not a foreign key; fresh ID for every retry/fallback']
  model_router_id bigint [not null]
  provider_model_id bigint [not null]
  provider_id bigint [not null]
  provider_request_id text [note: 'Optional provider-issued identifier; no credentials']
  status provider_usage_status [not null, default: 'in_progress']
  pricing_snapshot jsonb [not null, note: 'Immutable complete provider-model Pricing at attempt creation; identical across correlated rows. Variant selects billable measurements; multiple types do not automatically mean multiple charges']
  group_index integer [not null, default: 0, note: 'CHECK (group_index >= 0); identifies a non-overlapping quantity group within the attempt']
  image_count bigint [note: 'Generated images in this group; NULL means unknown; CHECK (image_count >= 0)']
  conditions jsonb [not null, default: '{}', note: 'Strict RateConditions object: optional resolution, quality, audio, serviceTier. Actual billing conditions, not arbitrary provider metadata; missing fields do not act as rate-selection wildcards']

  indexes {
    (organization_id, attempt_id, group_index) [unique, name: 'provider_image_usage_attempt_group_unique']
    (organization_id, model_usage_id) [name: 'provider_image_usage_model_usage_idx']
    (organization_id, provider_model_id) [name: 'provider_image_usage_provider_model_idx']
    (organization_id, model_router_id) [name: 'provider_image_usage_route_idx']
    (organization_id, provider_id, provider_request_id) [name: 'provider_image_usage_request_idx']
  }
}

Table provider_audio_usage [note: 'Proposed independent audio usage linked directly to model_usage: at most one row per input/output direction per attempt. attempt_id correlates typed records without a shared parent; repeated metadata and snapshots must agree. All-null quantities preserve attempts without reported usage. Pricing selects the unit; reporting seconds and characters does not bill both. STT commonly measures input duration; TTS output duration or input characters. Duplex pricing requires an explicit contract.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0); application-generated Hero snowflake ID']
  organization_id bigint [not null]
  model_usage_id bigint [not null]
  attempt_id bigint [not null, note: 'CHECK (attempt_id > 0); upstream-call correlation ID, not a foreign key; fresh ID for every retry/fallback']
  model_router_id bigint [not null]
  provider_model_id bigint [not null]
  provider_id bigint [not null]
  provider_request_id text [note: 'Optional provider-issued identifier; no credentials']
  status provider_usage_status [not null, default: 'in_progress']
  pricing_snapshot jsonb [not null, note: 'Immutable complete provider-model Pricing at attempt creation; identical across correlated rows. Snapshot selects duration or character billing, not both implicitly']
  direction usage_direction [not null, note: 'Direction of measured audio or text relative to the upstream request']
  duration_seconds numeric(24,9) [note: 'Exact measured seconds, not binary float; NULL means unknown; CHECK (duration_seconds >= 0)']
  character_count bigint [note: 'Measured characters; NULL means unknown; CHECK (character_count >= 0)']

  indexes {
    (organization_id, attempt_id, direction) [unique, name: 'provider_audio_usage_attempt_direction_unique']
    (organization_id, model_usage_id) [name: 'provider_audio_usage_model_usage_idx']
    (organization_id, provider_model_id) [name: 'provider_audio_usage_provider_model_idx']
    (organization_id, model_router_id) [name: 'provider_audio_usage_route_idx']
    (organization_id, provider_id, provider_request_id) [name: 'provider_audio_usage_request_idx']
  }
}

Table provider_video_usage [note: 'Proposed independent video usage linked directly to model_usage. Multiple non-overlapping billing groups per attempt; group_index is stable for idempotent updates, not an asset ID. attempt_id correlates typed records without a shared parent; repeated metadata and snapshots must agree. NULL duration preserves unknown or failed usage. No video content or URLs. Domain validation rejects overlapping groups and ambiguous rates.'] {
  id bigint [pk, not null, note: 'CHECK (id > 0); application-generated Hero snowflake ID']
  organization_id bigint [not null]
  model_usage_id bigint [not null]
  attempt_id bigint [not null, note: 'CHECK (attempt_id > 0); upstream-call correlation ID, not a foreign key; fresh ID for every retry/fallback']
  model_router_id bigint [not null]
  provider_model_id bigint [not null]
  provider_id bigint [not null]
  provider_request_id text [note: 'Optional provider-issued identifier; no credentials']
  status provider_usage_status [not null, default: 'in_progress']
  pricing_snapshot jsonb [not null, note: 'Immutable complete provider-model Pricing at attempt creation; identical across correlated rows. Snapshot selects billable measurements; reporting multiple types does not automatically charge all of them']
  group_index integer [not null, default: 0, note: 'CHECK (group_index >= 0); identifies a non-overlapping quantity group within the attempt']
  duration_seconds numeric(24,9) [note: 'Total measured generated duration in this group; NULL means unknown; CHECK (duration_seconds >= 0)']
  conditions jsonb [not null, default: '{}', note: 'Strict RateConditions object: optional resolution, quality, audio, serviceTier. Actual billing conditions, not arbitrary provider metadata; missing fields do not act as rate-selection wildcards']

  indexes {
    (organization_id, attempt_id, group_index) [unique, name: 'provider_video_usage_attempt_group_unique']
    (organization_id, model_usage_id) [name: 'provider_video_usage_model_usage_idx']
    (organization_id, provider_model_id) [name: 'provider_video_usage_provider_model_idx']
    (organization_id, model_router_id) [name: 'provider_video_usage_route_idx']
    (organization_id, provider_id, provider_request_id) [name: 'provider_video_usage_request_idx']
  }
}

// --- Relationships ---

Ref organization_members_organization_id_fkey: organization_members.organization_id > organizations.id [delete: cascade, update: no action]
Ref organization_members_user_id_fkey: organization_members.user_id > users.id [delete: cascade, update: no action]
Ref api_keys_membership_fkey: api_keys.(organization_id, user_id) > organization_members.(organization_id, user_id) [delete: cascade, update: no action]

Ref user_sessions_organization_fk: user_sessions.organization_id > organizations.id [delete: cascade, update: no action]
Ref user_sessions_user_fk: user_sessions.user_id > users.id [delete: cascade, update: no action]

Ref providers_organization_id_fkey: providers.organization_id > organizations.id [delete: cascade, update: no action]

Ref models_organization_id_fkey: models.organization_id > organizations.id [delete: cascade, update: no action]

// Composite scope foreign keys keep provider models and routes inside a single organization.
Ref provider_models_provider_scope_fkey: provider_models.(organization_id, provider_id) > providers.(organization_id, id) [delete: cascade, update: no action]
Ref model_router_model_scope_fkey: model_router.(organization_id, model_id) > models.(organization_id, id) [delete: cascade, update: no action]
Ref model_router_provider_model_scope_fkey: model_router.(organization_id, provider_model_id) > provider_models.(organization_id, id) [delete: cascade, update: no action]

Ref model_usage_organization_fkey: model_usage.organization_id > organizations.id [delete: restrict, update: no action]
Ref model_usage_user_fkey: model_usage.user_id > users.id [delete: restrict, update: no action]
Ref model_usage_membership_fkey: model_usage.(organization_id, user_id) > organization_members.(organization_id, user_id) [delete: restrict, update: no action]
Ref model_usage_api_key_scope_fkey: model_usage.(organization_id, api_key_id) > api_keys.(organization_id, id) [delete: restrict, update: no action]
Ref model_usage_api_key_owner_fkey: model_usage.(organization_id, user_id, api_key_id) > api_keys.(organization_id, user_id, id) [delete: restrict, update: no action]
Ref model_usage_model_scope_fkey: model_usage.(organization_id, model_id) > models.(organization_id, id) [delete: restrict, update: no action]

Ref model_usage_limit_membership_fkey: model_usage_limit.(organization_id, user_id) > organization_members.(organization_id, user_id) [delete: restrict, update: no action]

// Independent provider usage tables reference client attribution and upstream scope directly.
Ref provider_token_usage_model_usage_scope_fkey: provider_token_usage.(organization_id, model_usage_id) > model_usage.(organization_id, id) [delete: cascade, update: no action]
Ref provider_token_usage_route_scope_fkey: provider_token_usage.(organization_id, provider_model_id, model_router_id) > model_router.(organization_id, provider_model_id, id) [delete: restrict, update: no action]
Ref provider_token_usage_provider_model_scope_fkey: provider_token_usage.(organization_id, provider_id, provider_model_id) > provider_models.(organization_id, provider_id, id) [delete: restrict, update: no action]
Ref provider_token_usage_provider_scope_fkey: provider_token_usage.(organization_id, provider_id) > providers.(organization_id, id) [delete: restrict, update: no action]

Ref provider_image_usage_model_usage_scope_fkey: provider_image_usage.(organization_id, model_usage_id) > model_usage.(organization_id, id) [delete: cascade, update: no action]
Ref provider_image_usage_route_scope_fkey: provider_image_usage.(organization_id, provider_model_id, model_router_id) > model_router.(organization_id, provider_model_id, id) [delete: restrict, update: no action]
Ref provider_image_usage_provider_model_scope_fkey: provider_image_usage.(organization_id, provider_id, provider_model_id) > provider_models.(organization_id, provider_id, id) [delete: restrict, update: no action]
Ref provider_image_usage_provider_scope_fkey: provider_image_usage.(organization_id, provider_id) > providers.(organization_id, id) [delete: restrict, update: no action]

Ref provider_audio_usage_model_usage_scope_fkey: provider_audio_usage.(organization_id, model_usage_id) > model_usage.(organization_id, id) [delete: cascade, update: no action]
Ref provider_audio_usage_route_scope_fkey: provider_audio_usage.(organization_id, provider_model_id, model_router_id) > model_router.(organization_id, provider_model_id, id) [delete: restrict, update: no action]
Ref provider_audio_usage_provider_model_scope_fkey: provider_audio_usage.(organization_id, provider_id, provider_model_id) > provider_models.(organization_id, provider_id, id) [delete: restrict, update: no action]
Ref provider_audio_usage_provider_scope_fkey: provider_audio_usage.(organization_id, provider_id) > providers.(organization_id, id) [delete: restrict, update: no action]

Ref provider_video_usage_model_usage_scope_fkey: provider_video_usage.(organization_id, model_usage_id) > model_usage.(organization_id, id) [delete: cascade, update: no action]
Ref provider_video_usage_route_scope_fkey: provider_video_usage.(organization_id, provider_model_id, model_router_id) > model_router.(organization_id, provider_model_id, id) [delete: restrict, update: no action]
Ref provider_video_usage_provider_model_scope_fkey: provider_video_usage.(organization_id, provider_id, provider_model_id) > provider_models.(organization_id, provider_id, id) [delete: restrict, update: no action]
Ref provider_video_usage_provider_scope_fkey: provider_video_usage.(organization_id, provider_id) > providers.(organization_id, id) [delete: restrict, update: no action]
