{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2023", "DOM"],
    "paths": {
      "$houdini": ["../contract/houdini/generated/index.ts"],
      "$houdini/*": ["../contract/houdini/generated/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "stories/**/*.ts",
    "stories/**/*.js",
    "stories/**/*.svelte",
    ".storybook/**/*.ts",
    ".storybook/**/*.js",
    ".storybook/**/*.svelte"
  ]
}
